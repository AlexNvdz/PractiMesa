generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
  moduleFormat        = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_registers {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  location_id          String    @db.Uuid
  opened_by            String    @db.Uuid
  opened_at            DateTime  @default(now()) @db.Timestamptz(6)
  closed_at            DateTime? @db.Timestamptz(6)
  opening_amount_cop   Decimal   @db.Decimal(12, 2)
  expected_closing_cop Decimal?  @db.Decimal(12, 2)
  actual_closing_cop   Decimal?  @db.Decimal(12, 2)
  status               String    @default("OPEN") @db.VarChar(20)
  organization_id      String    @default(dbgenerated("app_org_id()")) @db.Uuid
  locations            locations @relation(fields: [location_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "cash_registers_location_fkey")
  users                users     @relation(fields: [opened_by, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "cash_registers_opened_by_fkey")
  orders               orders[]

  @@unique([id, organization_id], map: "cash_registers_id_org_key")
}

model categories {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String        @default(dbgenerated("app_org_id()")) @db.Uuid
  name            String        @db.VarChar(100)
  sort_order      Int           @default(0)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products        products[]

  @@unique([id, organization_id], map: "categories_id_org_key")
}

model customers {
  id                    String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id       String         @default(dbgenerated("app_org_id()")) @db.Uuid
  full_name             String         @db.VarChar(120)
  identification_type   String?        @default("13") @db.VarChar(10)
  identification_number String?        @default("222222222222") @db.VarChar(30)
  phone                 String         @db.VarChar(30)
  email                 String?        @db.VarChar(150)
  loyalty_points        Int            @default(0)
  organizations         organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders                orders[]
  reservations          reservations[]

  @@unique([organization_id, phone])
  @@unique([id, organization_id], map: "customers_id_org_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dining_tables {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  location_id     String         @db.Uuid
  name            String         @db.VarChar(40)
  capacity        Int            @default(4)
  status          String         @default("FREE") @db.VarChar(20)
  organization_id String         @default(dbgenerated("app_org_id()")) @db.Uuid
  locations       locations      @relation(fields: [location_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "dining_tables_location_fkey")
  orders          orders[]
  reservations    reservations[]

  @@unique([id, organization_id], map: "dining_tables_id_org_key")
}

model ingredients {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String            @default(dbgenerated("app_org_id()")) @db.Uuid
  name            String            @db.VarChar(120)
  unit            String            @db.VarChar(20)
  organizations   organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  location_stock  location_stock[]
  product_recipes product_recipes[]

  @@unique([id, organization_id], map: "ingredients_id_org_key")
}

model location_products {
  location_id      String    @db.Uuid
  product_id       String    @db.Uuid
  custom_price_cop Decimal?  @db.Decimal(12, 2)
  is_available     Boolean   @default(true)
  organization_id  String    @default(dbgenerated("app_org_id()")) @db.Uuid
  locations        locations @relation(fields: [location_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "location_products_location_fkey")
  products         products  @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "location_products_product_fkey")

  @@id([location_id, product_id])
}

model location_stock {
  location_id     String      @db.Uuid
  ingredient_id   String      @db.Uuid
  current_qty     Decimal     @default(0) @db.Decimal(12, 3)
  min_alert_qty   Decimal     @default(0) @db.Decimal(12, 3)
  organization_id String      @default(dbgenerated("app_org_id()")) @db.Uuid
  ingredients     ingredients @relation(fields: [ingredient_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "location_stock_ingredient_fkey")
  locations       locations   @relation(fields: [location_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "location_stock_location_fkey")

  @@id([location_id, ingredient_id])
}

model locations {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id   String              @default(dbgenerated("app_org_id()")) @db.Uuid
  name              String              @db.VarChar(120)
  city              String              @db.VarChar(80)
  address           String
  phone_whatsapp    String?             @db.VarChar(30)
  is_active         Boolean             @default(true)
  delivery_config   Json                @default("{\"zones\": [], \"enabled\": true, \"min_order_cop\": 15000}")
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  last_order_number Int                 @default(0)
  cash_registers    cash_registers[]
  dining_tables     dining_tables[]
  location_products location_products[]
  location_stock    location_stock[]
  organizations     organizations       @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders            orders[]
  reservations      reservations[]

  @@unique([id, organization_id], map: "locations_id_org_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id           String   @db.Uuid
  product_id         String   @db.Uuid
  quantity           Int
  unit_price_cop     Decimal  @db.Decimal(12, 2)
  selected_modifiers Json     @default("[]")
  notes              String?
  organization_id    String   @default(dbgenerated("app_org_id()")) @db.Uuid
  orders             orders   @relation(fields: [order_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_fkey")
  products           products @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_product_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id       String          @default(dbgenerated("app_org_id()")) @db.Uuid
  location_id           String          @db.Uuid
  cash_register_id      String?         @db.Uuid
  table_id              String?         @db.Uuid
  customer_id           String?         @db.Uuid
  order_number          Int             @default(0)
  channel               String          @db.VarChar(20)
  order_type            String          @db.VarChar(20)
  status                String          @default("PENDING") @db.VarChar(25)
  subtotal_cop          Decimal         @db.Decimal(12, 2)
  tax_cop               Decimal         @db.Decimal(12, 2)
  delivery_fee_cop      Decimal         @default(0) @db.Decimal(12, 2)
  discount_cop          Decimal         @default(0) @db.Decimal(12, 2)
  total_cop             Decimal         @db.Decimal(12, 2)
  payment_method        String?         @db.VarChar(30)
  payment_status        String          @default("UNPAID") @db.VarChar(20)
  factus_payment_ref    String?         @db.VarChar(120)
  factus_qr_payload     String?
  factus_invoice_number String?         @db.VarChar(50)
  factus_cufe           String?
  factus_status         String          @default("NOT_SENT") @db.VarChar(25)
  delivery_address      Json?
  scheduled_for         DateTime?       @db.Timestamptz(6)
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  order_items           order_items[]
  cash_registers        cash_registers? @relation(fields: [cash_register_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "orders_cash_register_fkey")
  customers             customers?      @relation(fields: [customer_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "orders_customer_fkey")
  locations             locations       @relation(fields: [location_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "orders_location_fkey")
  organizations         organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dining_tables         dining_tables?  @relation(fields: [table_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "orders_table_fkey")

  @@unique([id, organization_id], map: "orders_id_org_key")
  @@unique([location_id, order_number], map: "orders_location_number_key")
  @@index([factus_payment_ref], map: "idx_orders_factus_ref")
  @@index([organization_id, location_id, created_at(sort: Desc)], map: "idx_orders_org_loc_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model organizations {
  id                  String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                String         @db.VarChar(150)
  slug                String         @unique @db.VarChar(80)
  nit                 String?        @db.VarChar(30)
  plan_tier           String         @db.VarChar(20)
  max_locations       Int            @default(1)
  subscription_status String         @default("TRIAL") @db.VarChar(20)
  factus_config       Json           @default("{\"sandbox\": true, \"client_id\": null, \"numbering_range_id\": null}")
  ai_agent_enabled    Boolean        @default(false)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  categories          categories[]
  customers           customers[]
  ingredients         ingredients[]
  locations           locations[]
  orders              orders[]
  products            products[]
  reservations        reservations[]
  users               users[]
}

model product_recipes {
  product_id        String      @db.Uuid
  ingredient_id     String      @db.Uuid
  quantity_required Decimal     @db.Decimal(12, 3)
  organization_id   String      @default(dbgenerated("app_org_id()")) @db.Uuid
  ingredients       ingredients @relation(fields: [ingredient_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "product_recipes_ingredient_fkey")
  products          products    @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "product_recipes_product_fkey")

  @@id([product_id, ingredient_id])
}

model products {
  id                 String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id    String              @default(dbgenerated("app_org_id()")) @db.Uuid
  category_id        String?             @db.Uuid
  name               String              @db.VarChar(150)
  description        String?
  base_price_cop     Decimal             @db.Decimal(12, 2)
  tax_rate           Decimal             @default(8.00) @db.Decimal(5, 2)
  dian_standard_code String?             @default("999") @db.VarChar(30)
  image_url          String?
  modifiers_schema   Json                @default("[]")
  is_active          Boolean             @default(true)
  location_products  location_products[]
  order_items        order_items[]
  product_recipes    product_recipes[]
  categories         categories?         @relation(fields: [category_id, organization_id], references: [id, organization_id], onDelete: SetNull, onUpdate: NoAction, map: "products_category_fkey")
  organizations      organizations       @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, organization_id], map: "products_id_org_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservations {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String         @default(dbgenerated("app_org_id()")) @db.Uuid
  location_id     String         @db.Uuid
  customer_id     String?        @db.Uuid
  table_id        String?        @db.Uuid
  party_size      Int
  reserved_at     DateTime       @db.Timestamptz(6)
  source          String         @default("MANUAL") @db.VarChar(20)
  status          String         @default("CONFIRMED") @db.VarChar(20)
  customers       customers?     @relation(fields: [customer_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "reservations_customer_fkey")
  locations       locations      @relation(fields: [location_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction, map: "reservations_location_fkey")
  organizations   organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dining_tables   dining_tables? @relation(fields: [table_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "reservations_table_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id      String           @default(dbgenerated("app_org_id()")) @db.Uuid
  email                String           @unique @db.VarChar(150)
  password_hash        String
  full_name            String           @db.VarChar(120)
  role                 String           @db.VarChar(30)
  allowed_location_ids String[]         @db.Uuid
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  cash_registers       cash_registers[]
  refresh_tokens       refresh_tokens[]
  organizations        organizations    @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, organization_id], map: "users_id_org_key")
}

model webhook_events {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  provider          String    @db.VarChar(40)
  external_event_id String    @unique @db.VarChar(150)
  payload           Json
  processed         Boolean   @default(false)
  processed_at      DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user")
}
