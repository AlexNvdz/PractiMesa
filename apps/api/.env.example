# --- App ---
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (web app + storefront wildcard handled in code later)
CORS_ORIGINS=http://localhost:3000
# Root domain for storefront subdomains: <slug>.practimesa.local
APP_ROOT_DOMAIN=localhost

# --- Database (docker compose: postgres) ---
DATABASE_URL=postgresql://practimesa:practimesa@localhost:5433/practimesa?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- Seed (npm run db:seed) ---
# Password for seeded demo users; random (printed once) if empty.
SEED_PASSWORD=

# --- Factus (facturacion electronica) ---
# Credentials: request them from Factus (https://www.factus.com.co, "aliados e integradores").
# Sandbox: https://api-sandbox.factus.com.co | Production: https://api.factus.com.co
# FACTUS_USERNAME is the email of your Factus user. Verify with: npm run factus:check -w apps/api
FACTUS_API_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
# Default numbering range for POS equivalent document / invoice (overridable per org in factus_config)
FACTUS_NUMBERING_RANGE_ID=

# --- Credentials of each business (Factus Pay, Factus), sealed in the DB with AES-256-GCM ---
# 32 random bytes in base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes the stored credentials unreadable (owners must enter them again).
CREDENTIALS_KEY=

# Invoice retry job (every minute). Set to off to disable it (tests do).
# INVOICE_JOB=off

# --- Factus Pay (recaudos QR Bre-B + webhook) ---
# Docs: https://pay-developers.factus.com.co | Panel sandbox: https://pay-api-sandbox.factus.com.co
# Production API: https://pay-api.factus.com.co
# Shared account used by businesses without their own (PUT /api/integrations/factus-pay). Demo/staging only:
# leave EMAIL/PASSWORD empty in production so no business charges into this account.
# Auth = email/password of your Factus Pay panel user (POST /auth). Each /auth revokes the previous token.
FACTUS_PAY_API_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=
# Key you also set in the panel (section Webhook). Factus Pay sends it as ?key=... on each webhook.
# Generate (32+ chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACTUS_PAY_WEBHOOK_KEY=change-me
# Webhook URL of the shared account to register in its panel: https://<api-host>/api/webhooks/factus-pay
# (a business with its own account registers https://<api-host>/api/webhooks/factus-pay/<organization-id>)

# --- Cloudflare R2 (imagenes) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=practimesa-media
R2_PUBLIC_URL=

# --- SonarQube (used by `npm run sonar`) ---
SONAR_TOKEN=
